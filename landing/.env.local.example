# ── Base URL ────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Auth (JWT para sesiones de usuario) ────────────────────────────────────
# Genera un secreto seguro: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# ── Base de datos (Drizzle ORM + PostgreSQL) ────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
POSTGRES_URL=postgresql://postgres:password@localhost:5432/talenthub

# ── Stripe ──────────────────────────────────────────────────────────────────
# Obtén estos valores en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── Supabase (para waitlist y datos compartidos) ────────────────────────────
# Obtén estos valores en: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
